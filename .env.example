# ---------------------------------------------------------------------------
# Dilly Kitchen — Supabase configuration
#
# Copy this file to `.env.local` and fill in the two values from
# Supabase dashboard → Project Settings → API. `.env.local` is gitignored.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and
# these two are the only ones the site needs.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon" / publishable key. This one is MEANT to be public: it identifies
# the project, and Row Level Security decides what it may actually do.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NEVER put the service_role (secret) key in this project.
#
# It bypasses Row Level Security completely. Anything prefixed with VITE_ is
# compiled into the JavaScript every visitor downloads, so a service key placed
# here would be published to the world. Schema and seed changes are applied with
# the Supabase CLI (`supabase db push`), which authenticates on its own and
# needs no key in this repo.
# ---------------------------------------------------------------------------
